    private async Task AnalyzeUrl()
    {
        errorMessage = "";

        if (!IsValidUrl) 
        { 
            errorMessage = "Please enter a valid URL starting with http:// or https://"; 
            return; 
        }

       isBusy = true;
        StateHasChanged();

        try
        {
            preview = await MediaClient.AnalyzeUrlAsync(urlInput);
            if (preview != null)
            {
                showDownloadModal = true;
            }
            else
            {
                errorMessage = "Could not find video info. Check the link!";
            }
        }
       catch
        {
            errorMessage = "Server error.";
        }
        finally
        {
            isBusy = false;
            StateHasChanged();
        }
    
    }

    private readonly string[] progressStages = new[]
    {
        "Contacting server…",
        "Extracting media stream…",
        "Packaging your file…",
        "Almost there…"
    };
    private int downloadProgress = 0;
    private string downloadStage = "";

    private async Task Download(string type)
    {
        showDownloadModal = false;
        isDownloading = true;
        showSuccess = false;
        downloadProgress = 0;
        downloadStage = progressStages[0];
        await InvokeAsync(StateHasChanged);

        var downloadUrl = MediaClient.BuildDownloadUrl(urlInput, type);
        await JS.InvokeVoidAsync("location.assign", downloadUrl);

        // The actual file transfer happens via browser navigation, so we don't get
        // real byte-level progress from the server. Instead of a blank spinner for
        // ~7s, animate a staged progress bar with rotating status text so the wait
        // feels purposeful rather than stalled.
        const int totalTicks = 28; // 28 * 250ms ≈ 7s
        for (int i = 0; i < totalTicks; i++)
        {
            await Task.Delay(250);
            downloadProgress = Math.Min(96, (int)((i + 1) / (double)totalTicks * 100));
            var stageIndex = Math.Min(progressStages.Length - 1, i / (totalTicks / progressStages.Length));
            downloadStage = progressStages[stageIndex];
            await InvokeAsync(StateHasChanged);
        }

        downloadProgress = 100;
        showSuccess = true;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(2500);
        isDownloading = false;
        showSuccess = false;
        downloadProgress = 0;
        await InvokeAsync(StateHasChanged);
    }

    private static readonly (string Match, string Name, string Icon)[] platformMap = new[]
    {
        ("tiktok.com", "TikTok", "bi-tiktok"),
        ("reddit.com", "Reddit", "bi-reddit"),
        ("youtube.com", "YouTube", "bi-youtube"),
        ("youtu.be", "YouTube", "bi-youtube"),
        ("instagram.com", "Instagram", "bi-instagram"),
        ("facebook.com", "Facebook", "bi-facebook"),
        ("fb.watch", "Facebook", "bi-facebook"),
        ("pinterest.com", "Pinterest", "bi-pinterest"),
        ("pin.it", "Pinterest", "bi-pinterest"),
        ("twitch.tv", "Twitch", "bi-twitch"),
        ("soundcloud.com", "SoundCloud", "bi-music-note-beamed"),
        ("linkedin.com", "LinkedIn", "bi-linkedin"),
    };

    private (string Name, string Icon) DetectPlatform(string url)
    {
        if (!string.IsNullOrWhiteSpace(url))
        {
            foreach (var (match, name, icon) in platformMap)
            {
                if (url.Contains(match, StringComparison.OrdinalIgnoreCase))
                {
                    return (name, icon);
                }
            }
        }
        return ("Media", "bi-play-circle-fill");
    }

private string MediaUrl { get; set; } = string.Empty;

