@if ((showDownloadModal || isDownloading) && preview != null)
{
    var platform = DetectPlatform(urlInput);

    <div class="modal fade show d-block vms-modal-backdrop" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="vms-modal-card">

                @if (!isDownloading)
                {
                    <button type="button" class="vms-modal-close" @onclick="() => showDownloadModal = false" aria-label="Close">
                        <i class="bi bi-x-lg"></i>
                    </button>

                    <div class="vms-thumb-wrap">
                        @if (!string.IsNullOrEmpty(preview.ThumbnailUrl))
                        {
                            <div class="vms-thumb-backdrop" style="background-image:url('@preview.ThumbnailUrl');"></div>
                            <img src="@preview.ThumbnailUrl" alt="@preview.Title" class="vms-thumb-img" />
                        }
                        else
                        {
                            <div class="vms-thumb-fallback">
                                <i class="bi @platform.Icon"></i>
                            </div>
                        }
                        <div class="vms-thumb-gradient"></div>
                        <span class="vms-platform-chip">
                            <i class="bi @platform.Icon"></i> @platform.Name
                        </span>
                    </div>

                    <div class="vms-modal-body">
                        <p class="vms-modal-eyebrow">Ready to save</p>
                        <h5 class="vms-modal-title">@preview.Title</h5>

                        <div class="d-grid gap-2 mt-3">
                            <button class="vms-download-btn vms-download-btn-video" @onclick='() => Download("video")'>
                                <i class="bi bi-camera-reels-fill"></i>
                                <span>Download MP4 Video</span>
                            </button>
                            <button class="vms-download-btn vms-download-btn-audio" @onclick='() => Download("mp3")'>
                                <i class="bi bi-music-note-beamed"></i>
                                <span>Download MP3 Audio</span>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="vms-progress-panel">
                        <div class="vms-thumb-wrap vms-thumb-wrap-small">
                            @if (!string.IsNullOrEmpty(preview.ThumbnailUrl))
                            {
                                <div class="vms-thumb-backdrop" style="background-image:url('@preview.ThumbnailUrl');"></div>
                                <img src="@preview.ThumbnailUrl" alt="@preview.Title" class="vms-thumb-img" />
                            }
                            <div class="vms-thumb-gradient"></div>
                        </div>

                        <div class="vms-modal-body text-center">
                            @if (!showSuccess)
                            {
                                <div class="vms-spin-ring mb-3">
                                    <i class="bi bi-cloud-arrow-down-fill"></i>
                                </div>
                                <h6 class="vms-modal-title mb-1">@downloadStage</h6>
                                <p class="vms-progress-caption">Hang tight — this usually takes a few seconds.</p>

                                <div class="vms-progress-track mt-3">
                                    <div class="vms-progress-fill" style="width:@(downloadProgress)%;"></div>
                                </div>
                                <p class="vms-progress-percent">@downloadProgress%</p>
                            }
                            else
                            {
                                <div class="vms-success-check mb-3">
                                    <i class="bi bi-check-lg"></i>
                                </div>
                                <h6 class="vms-modal-title mb-1">Download started!</h6>
                                <p class="vms-progress-caption">Check your browser's downloads for the file.</p>
                            }
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
}

