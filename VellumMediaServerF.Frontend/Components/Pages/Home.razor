<style>
    .vms-modal-backdrop {
        background: rgba(8, 12, 20, 0.65);
        backdrop-filter: blur(3px);
    }

    .vms-modal-card {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
        position: relative;
        pointer-events: auto; /* Bootstrap's .modal-dialog sets pointer-events: none;
                                  .modal-content normally restores it — since we swapped
                                  that class out, we need to restore it here too, or the
                                  whole card (buttons included) is visually present but
                                  completely unclickable. */
        animation: vms-modal-in 0.25s ease-out;
    }

    @@keyframes vms-modal-in {
        from { opacity: 0; transform: translateY(12px) scale(0.98); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .vms-modal-close {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 3;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: none;
        background: rgba(0, 0, 0, 0.45);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        transition: background 0.15s ease;
    }

    .vms-modal-close:hover {
        background: rgba(0, 0, 0, 0.65);
    }

    .vms-thumb-wrap {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        background: linear-gradient(135deg, #0b1220, #163044);
        overflow: hidden;
    }

    .vms-thumb-wrap-small {
        aspect-ratio: 21 / 9;
    }

    .vms-thumb-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
        position: relative;
        z-index: 1;
    }

    .vms-thumb-backdrop {
        position: absolute;
        inset: -10px;
        background-size: cover;
        background-position: center;
        filter: blur(22px) brightness(0.55);
        transform: scale(1.1);
    }

    .vms-thumb-fallback {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: rgba(255, 255, 255, 0.35);
    }

    .vms-thumb-gradient {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 55%);
    }

    .vms-platform-chip {
        position: absolute;
        left: 14px;
        bottom: 12px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(6px);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.02em;
        border: 1px solid rgba(255, 255, 255, 0.25);
    }

    .vms-modal-body {
        padding: 20px 24px 24px;
    }

    .vms-modal-eyebrow {
        margin: 0 0 4px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #14b8a6;
    }

    .vms-modal-title {
        font-weight: 700;
        color: #101828;
        margin: 0 0 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .vms-download-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: none;
        border-radius: 12px;
        padding: 13px 16px;
        font-weight: 600;
        font-size: 15px;
        color: #fff;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

    .vms-download-btn:hover {
        transform: translateY(-1px);
    }

    .vms-download-btn-video {
        background: linear-gradient(135deg, #22c55e, #16a34a);
        box-shadow: 0 6px 16px rgba(34, 197, 94, 0.35);
    }

    .vms-download-btn-audio {
        background: linear-gradient(135deg, #22d3ee, #0891b2);
        box-shadow: 0 6px 16px rgba(6, 182, 212, 0.3);
    }

    .vms-spin-ring {
        width: 54px;
        height: 54px;
        margin: 0 auto;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        color: #0891b2;
        background: conic-gradient(#22d3ee 0deg, #e6fbff 0deg);
        animation: vms-spin 1.1s linear infinite;
        position: relative;
    }

    .vms-spin-ring::after {
        content: "";
        position: absolute;
        inset: 5px;
        background: #fff;
        border-radius: 50%;
    }

    .vms-spin-ring i {
        position: relative;
        z-index: 1;
    }

    @@keyframes vms-spin {
        to { transform: rotate(360deg); }
    }

    .vms-progress-caption {
        font-size: 13px;
        color: #667085;
        margin-bottom: 0;
    }

    .vms-progress-track {
        width: 100%;
        height: 8px;
        border-radius: 999px;
        background: #eef2f6;
        overflow: hidden;
    }

    .vms-progress-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #22d3ee, #16a34a);
        transition: width 0.25s ease;
    }

    .vms-progress-percent {
        font-size: 12px;
        font-weight: 600;
        color: #667085;
        margin: 6px 0 0;
    }

    .vms-success-check {
        width: 60px;
        height: 60px;
        margin: 0 auto;
        border-radius: 50%;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        animation: vms-pop 0.35s ease-out;
    }

    .vms-marquee-container {
        overflow: hidden;
        position: relative;
        background: linear-gradient(135deg, #0b1220, #163044);
        padding: 18px 0;
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    }

    .vms-marquee-track {
        display: flex;
        width: max-content;
        animation: vms-marquee-scroll 22s linear infinite;
    }

    .vms-marquee-container:hover .vms-marquee-track {
        animation-play-state: paused;
    }

    @@keyframes vms-marquee-scroll {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }

    .vms-marquee-content {
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }

    .vms-marquee-item {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 28px;
        color: #ffffff;
        opacity: 0.9;
        font-weight: 600;
        font-size: 1.1rem;
        white-space: nowrap;
    }

    .vms-marquee-item i {
        font-size: 1.4rem;
        color: #5eead4;
    }

    .vms-marquee-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.3);
        margin: 0 0 0 0;
    }
</style>

